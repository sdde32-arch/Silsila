/**
 * Returns direct CDN audio URL for any verse of the Quran by any reciter
 */
export function getAyahAudioUrl(
  surahNumber: number,
  ayahNumber: number,
  reciterSubfolder: string = 'Alafasy_128kbps'
): string {
  const surahPadded = String(surahNumber).padStart(3, '0');
  const ayahPadded = String(ayahNumber).padStart(3, '0');
  return `https://everyayah.com/data/${reciterSubfolder}/${surahPadded}${ayahPadded}.mp3`;
}

/**
 * Certified Uthmani Bismillah stripper.
 * In the Medina Mushaf / standard Global Quran:
 * - Surah 1 (Al-Fatihah): Bismillah IS Ayah 1.
 * - Surah 9 (At-Tawbah): Has no Bismillah.
 * - Surahs 2 to 114 (excluding 9): Bismillah is an unnumbered opening header above the Surah, NOT part of Ayah 1.
 * APIs (like AlQuran Cloud, Tanzil, Quran.com) sometimes prepend the Bismillah into the text of Ayah 1.
 * This function cleanly removes ANY variation of the opening Bismillah from Ayah 1.
 */
export function removeBismillahFromAyah(surahNumber: number, ayahNumber: number, text: string): string {
  if (surahNumber === 1 || surahNumber === 9 || ayahNumber !== 1) {
    return text;
  }
  if (!text) return '';

  let cleaned = text.trim();

  // Known exact prefix forms across different Uthmani & standard editions
  const knownPrefixes = [
    'بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ',
    'بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ',
    'بِسْمِ ٱللَّهِ ٱلرَّحْمَٰنِ ٱلرَّحِيمِ',
    'بِسْمِ اللَّهِ الرَّحْمَٰنِ الرَّحِيمِ',
    'بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ',
    'بِسْمِ اللهِ الرَّحْمَنِ الرَّحِيمِ',
    'بِسْمِ اللهِ الرَّحْمٰنِ الرَّحِيْمِ',
    'بِسمِ اللَّهِ الرَّحمٰنِ الرَّحيمِ',
    'بسم الله الرحمن الرحيم',
  ];

  for (const prefix of knownPrefixes) {
    if (cleaned.startsWith(prefix)) {
      return cleaned.slice(prefix.length).trim();
    }
  }

  // Regex fallback: Match 4 words starting with Bismi at the beginning
  const bismillahRegex = /^[\s\uFEFF\u200B-\u200F\u061C\u06D6-\u06ED]*(?:بِسْمِ|بِسمِ|بسم)\s+[\u0600-\u06FF\u08A0-\u08FF]+\s+[\u0600-\u06FF\u08A0-\u08FF]+\s+[\u0600-\u06FF\u08A0-\u08FF]+[\s\uFEFF\u200B-\u200F\u061C\u06D6-\u06ED]*/u;
  if (bismillahRegex.test(cleaned)) {
    cleaned = cleaned.replace(bismillahRegex, '').trim();
  }

  return cleaned;
}

export function removeBismillahFromTransliteration(surahNumber: number, ayahNumber: number, text: string): string {
  if (surahNumber === 1 || surahNumber === 9 || ayahNumber !== 1 || !text) return text;
  return text.replace(/^[\s]*(?:bismil\s*laahir\s*rahmaanir\s*raheem|bismi\s*allahi\s*ar-rahmani\s*ar-rahim|bismillahir\s*rahmanir\s*rahim|bismi\s*allāhi\s*ar-raḥmāni\s*ar-raḥīmi)\s*[-–—:.]*\s*/i, '').trim();
}

export function removeBismillahFromTranslation(surahNumber: number, ayahNumber: number, text: string): string {
  if (surahNumber === 1 || surahNumber === 9 || ayahNumber !== 1 || !text) return text;
  return text.replace(/^[\s]*(?:in\s+the\s+name\s+of\s+allah[,\s]+the\s+entirely\s+merciful[,\s]+the\s+especially\s+merciful[.\s]*[-–—:]*)\s*/i, '').trim();
}

/** In-memory cache for fetched Surahs */
const surahCache = new Map<number, SurahContent>();

/**
 * Fetch and assemble complete Quran data for ANY of the 114 Surahs.
 * Merges Arabic Uthmani text, English Sahih International translation,
 * and phonetic transliteration into individual word units.
 */
export async function getSurahCompleteData(
  surahNumber: number,
  reciterSubfolder: string = 'Alafasy_128kbps'
): Promise<SurahContent> {
  // 1. Check in-memory cache
  if (surahCache.has(surahNumber)) {
    const cached = surahCache.get(surahNumber)!;
    return updateAudioUrls(cached, reciterSubfolder);
  }

  // 2. Check local storage cache
  try {
    const localSaved = localStorage.getItem(`quran_surah_${surahNumber}_v2`);
    if (localSaved) {
      const parsed: SurahContent = JSON.parse(localSaved);
      if (parsed.ayahs && parsed.ayahs.length === parsed.totalAyahs) {
        surahCache.set(surahNumber, parsed);
        return updateAudioUrls(parsed, reciterSubfolder);
      }
    }
  } catch (e) {
    // Ignore localStorage parse errors
  }

  // 3. Check pre-bundled rich data
  if (SURAH_CONTENT_DB[surahNumber] && SURAH_CONTENT_DB[surahNumber].ayahs.length >= SURAH_CONTENT_DB[surahNumber].totalAyahs) {
    const data = SURAH_CONTENT_DB[surahNumber];
    surahCache.set(surahNumber, data);
    return updateAudioUrls(data, reciterSubfolder);
  }

  // 4. Fetch full 114 Surah data live from AlQuran Cloud API
  try {
    const meta = ALL_114_SURAHS.find((s) => s.number === surahNumber) || {
      number: surahNumber,
      name: `Surah ${surahNumber}`,
      transliteration: `Surah ${surahNumber}`,
      arabicName: `سورة ${surahNumber}`,
      translation: `Chapter ${surahNumber}`,
      totalAyahs: 10,
      revelationType: 'Meccan' as const,
      juzNumber: 1,
      pageNumber: 1,
    };

    const res = await fetch(
      `https://api.alquran.cloud/v1/surah/${surahNumber}/editions/quran-uthmani,en.sahih,en.transliteration`
    );

    if (res.ok) {
      const json = await res.json();
      if (json.code === 200 && Array.isArray(json.data) && json.data.length >= 3) {
        const arabicData = json.data[0].ayahs;
        const translationData = json.data[1].ayahs;
        const transliterationData = json.data[2].ayahs;

        const ayahs: AyahDetail[] = arabicData.map((a: any, idx: number) => {
          const ayahNum = a.numberInSurah;
          let arabicText = a.text;
          let transText = translationData[idx]?.text || '';
          let translitText = transliterationData[idx]?.text || '';

          // Clean Bismillah from Verse 1 for all Surahs other than Al-Fatiha (Surah 1) and At-Tawbah (Surah 9)
          if (ayahNum === 1 && surahNumber !== 1 && surahNumber !== 9) {
            arabicText = removeBismillahFromAyah(surahNumber, ayahNum, arabicText);
            translitText = removeBismillahFromTransliteration(surahNumber, ayahNum, translitText);
            transText = removeBismillahFromTranslation(surahNumber, ayahNum, transText);
          }

          // Split arabic text into words for interactive word masking
          const arabicWords = arabicText.split(' ').filter(Boolean);
          const words = arabicWords.map((w: string, widx: number) => ({
            id: widx + 1,
            arabic: w,
            transliteration: '',
            translation: '',
          }));

          return {
            number: ayahNum,
            arabic: arabicText,
            transliteration: translitText,
            translation: transText,
            words,
            audioUrl: getAyahAudioUrl(surahNumber, ayahNum, reciterSubfolder),
            isMemorized: false,
          };
        });

        const fullContent: SurahContent = {
          number: surahNumber,
          name: meta.name,
          transliteration: meta.transliteration,
          arabicName: meta.arabicName,
          translation: meta.translation,
          totalAyahs: meta.totalAyahs,
          revelationType: meta.revelationType,
          juzNumber: meta.juzNumber,
          pageNumber: meta.pageNumber,
          background: getSurahBackground(surahNumber, meta),
          thematicPillars: getThematicPillars(surahNumber),
          ayahs,
        };

        surahCache.set(surahNumber, fullContent);
        try {
          localStorage.setItem(`quran_surah_${surahNumber}_v2`, JSON.stringify(fullContent));
        } catch (e) {
          // localStorage full or restricted
        }
        return fullContent;
      }
    }
  } catch (err) {
    console.warn(`Could not load full live data for Surah ${surahNumber}:`, err);
  }

  // 5. Fallback to pre-bundled Surah content
  if (SURAH_CONTENT_DB[surahNumber]) {
    return updateAudioUrls(SURAH_CONTENT_DB[surahNumber], reciterSubfolder);
  }

  // 6. Generic synthesized fallback for instant display
  const meta = ALL_114_SURAHS.find((s) => s.number === surahNumber) || ALL_114_SURAHS[0];
  const fallbackAyahs: AyahDetail[] = Array.from({ length: meta.totalAyahs }, (_, i) => {
    const num = i + 1;
    return {
      number: num,
      arabic: num === 1 ? 'بِسْمِ ٱللَّهِ ٱلرَّحْمَـٰنِ ٱلرَّحِيمِ' : `آية ${num} مِنْ ${meta.arabicName}`,
      transliteration: `Verse ${num} of Surah ${meta.transliteration}`,
      translation: `In the name of Allah, the Entirely Merciful, the Especially Merciful. (Ayah ${num})`,
      words: [{ id: 1, arabic: 'ٱللَّهِ', transliteration: 'Allah', translation: 'Allah' }],
      audioUrl: getAyahAudioUrl(surahNumber, num, reciterSubfolder),
    };
  });

  return {
    number: meta.number,
    name: meta.name,
    transliteration: meta.transliteration,
    arabicName: meta.arabicName,
    translation: meta.translation,
    totalAyahs: meta.totalAyahs,
    revelationType: meta.revelationType,
    juzNumber: meta.juzNumber,
    pageNumber: meta.pageNumber,
    background: getSurahBackground(surahNumber, meta),
    thematicPillars: getThematicPillars(surahNumber),
    ayahs: fallbackAyahs,
  };
}

function updateAudioUrls(content: SurahContent, reciterSubfolder: string): SurahContent {
  return {
    ...content,
    ayahs: content.ayahs.map((a) => ({
      ...a,
      audioUrl: getAyahAudioUrl(content.number, a.number, reciterSubfolder),
    })),
  };
}

function getSurahBackground(surahNum: number, meta: SurahMeta): string {
  const backgrounds: Record<number, string> = {
    1: 'Revealed in Makkah, Al-Fatihah serves as the foundational opening of the Quran and the indispensable pillar of every Salah. It establishes Tawhid and teaches how to ask for divine guidance.',
    2: 'The longest Surah in the Quran, revealed in Madinah. It contains comprehensive legislation, the story of Adam, the covenant with Bani Israel, Ayat al-Kursi, and the foundation of Islamic law and ethics.',
    3: 'Revealed in Madinah after the Battle of Uhud. It addresses the Christians of Najran, emphasizes the true nature of Isa (Jesus), steadfastness in faith, and unity under trials.',
    4: 'Revealed in Madinah, An-Nisa establishes laws for inheritance, marriage, protection of orphans, family rights, justice, and societal obligations.',
    5: 'One of the final major revelations in Madinah, Al-Ma\'idah details dietary laws, the perfection of the religion ("Today I have perfected for you your religion"), and treaties.',
    6: 'Revealed in Makkah all at once, Al-An\'am establishes the fundamentals of Tawhid, refutes idolatrous polytheism, and highlights cosmic signs of divine creation.',
    18: 'Revealed in Makkah, Al-Kahf offers protection from the trials of the Dajjal through four profound parables: Faith (People of the Cave), Wealth (Two Gardens), Knowledge (Musa & Al-Khidr), and Power (Dhul-Qarnayn).',
    36: 'Often referred to as the "Heart of the Quran", Ya-Sin reinforces the certainty of resurrection, the messengers sent to the township, and the signs of divine creation throughout the cosmos.',
    55: 'Known as the "Bride of the Quran", Ar-Rahman repeatedly asks: "So which of the favors of your Lord would you deny?", enumerating blessings in this life and the gardens of Paradise.',
    56: 'Al-Waqi\'ah vividly describes the events of the Day of Judgment, categorizing humanity into three groups: the Foremost (As-Sabiqun), the People of the Right, and the People of the Left.',
    67: 'Known as "The Protector" and "The Savior", Al-Mulk defends its reciter in the grave. It emphasizes Allah\'s absolute sovereignty, cosmic design, and the purpose of life and death.',
    112: 'Al-Ikhlas is equivalent to one-third of the Quran in virtue, encapsulating the purest definition of Allah\'s absolute oneness, self-sufficiency, and eternal transcendence.',
    113: 'Al-Falaq is a powerful prayer for divine refuge from external evils: darkness, witchcraft, and the malicious envy of others.',
    114: 'An-Nas is a prayer for divine protection against internal spiritual attacks: the whispered suggestions of Satan and hidden evil inclinations.',
  };

  return (
    backgrounds[surahNum] ||
    `Surah ${meta.name} (${meta.arabicName}) was revealed in ${meta.revelationType === 'Meccan' ? 'Makkah' : 'Madinah'}. It contains ${meta.totalAyahs} verses in Juz ${meta.juzNumber} on page ${meta.pageNumber}, establishing spiritual guidance, moral clarity, and divine monotheism.`
  );
}

function getThematicPillars(surahNum: number): string[] {
  const pillars: Record<number, string[]> = {
    1: ['Praise of Allah', 'Sovereignty of Judgment Day', 'Sincere Worship', 'The Straight Path'],
    2: ['Tawhid & Guidance', 'Stories of the Prophets', 'Legal Decrees & Fasting', 'Ayat Al-Kursi'],
    3: ['Steadfastness in Faith', 'The Battle of Uhud', 'Refutation of Trinity', 'Prophet Isa\'s Virgin Birth'],
    4: ['Rights of Orphans & Women', 'Inheritance Laws', 'Justice in Society', 'Hypocrisy & Loyalty'],
    5: ['Completion of Religion', 'Dietary & Halal Regulations', 'Covenants & Oaths', 'Truth of Messiah'],
    6: ['Cosmic Signs of Creation', 'Refutation of Idolatry', 'Prophetic Lineage of Ibrahim', 'Divine Omniscience'],
    18: ['Trial of Faith (Cave)', 'Trial of Wealth (Gardens)', 'Trial of Knowledge (Khidr)', 'Trial of Power (Dhul-Qarnayn)'],
    36: ['Prophetic Truth', 'Signs in the Earth & Heavens', 'Certainty of Resurrection', 'The Parable of the City'],
    55: ['Infinite Divine Mercy', 'Blessings of Nature', 'The Realities of Hellfire', 'Twin Gardens of Jannah'],
    56: ['The Inevitable Day', 'The Three Groups of Mankind', 'The High Gardens', 'Purity of the Quran'],
    67: ['Divine Sovereignty', 'Perfection of Creation', 'Protection in the Grave', 'The Flocks of Birds'],
    112: ['Absolute Oneness', 'Self-Sufficiency (As-Samad)', 'Eternal Transcendence', 'Unmatched Uniqueness'],
    113: ['Refuge from the Dawn', 'Protection from Darkness', 'Guarding from Evil Arts', 'Refuge from Envy'],
    114: ['Lord of Mankind', 'King of Mankind', 'God of Mankind', 'Protection from Whispering Spirits'],
  };

  return pillars[surahNum] || ['Divine Monotheism (Tawhid)', 'Prophetic Guidance', 'Moral Reflection & Accountability'];
}


export interface TafsirInfo {
  surahNumber: number;
  ayahNumber: number;
  surahName: string;
  arabicText: string;
  translation: string;
  tafsirText: string;
  source: string;
  thematicLesson: string;
  reflectionPoints: string[];
}


  try {
    const res = await fetch('/api/gemini/ayah-insights', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        surahNumber,
        ayahNumber,
        surahName,
        arabicText,
        translation,
        transliteration,
      }),
    });
    if (res.ok) {
      const data = await res.json();
      try {
        localStorage.setItem(cacheKey, JSON.stringify(data));
      } catch (e) {}
      return data;
    }
  } catch (err) {
    console.error('Fetch ayah insights error:', err);
  }

  // Fallback
  return {
    memorizationHook: `Anchor the first word of Ayah ${ayahNumber} ("${arabicText.split(' ')[0] || ''}") and visualize the meaning: "${translation.slice(0, 50)}...".`,
    transitionGuidance: `Connect the ending cadence with the opening sound of the following verse to maintain fluent Hifz momentum.`,
    mutashabihatAlert: `Note the exact phrase placement in Surah ${surahName} to avoid switching to similar Quranic verses.`,
    keyRoots: [
      { root: 'ر-ح-م', word: 'Mercy', meaning: 'Encompassing divine compassion', memoryTip: 'Key theme in opening chapters' },
      { root: 'ع-ل-م', word: 'Knowledge', meaning: 'Divine wisdom and clarity', memoryTip: 'Anchor for spiritual understanding' },
    ],
    tajweedFocus: ['Maintain consistent Madd elongation', 'Clear Ghunnah on Noon and Meem Mushaddad'],
    spiritualHeartAnchor: `Reflect on how this verse guides your character and mindfulness of Allah today.`,
    repetitionStrategy: '3x reading while looking, 5x reciting from memory, 3x connecting with adjacent verses.',
  };
}

export interface WordMorphology {
  id: number;
  arabic: string;
  transliteration: string;
  translation: string;
  root?: string;
  grammar?: string;
}

/**
 * Classical Tafsir (Ibn Kathir & As-Sa'di summary) for any Ayah
 */
export async function getAyahTafsir(
  surahNumber: number,
  ayahNumber: number,
  surahName: string,
  arabicText: string,
  translation: string
): Promise<TafsirInfo> {
  // Check local cache
  const cacheKey = `tafsir_${surahNumber}_${ayahNumber}`;
  try {
    const cached = localStorage.getItem(cacheKey);
    if (cached) return JSON.parse(cached);
  } catch (e) {}

  // Curated deep tafsir for prominent Ayahs
  const curatedTafsir: Record<string, { text: string; lesson: string; reflections: string[] }> = {
    '1:1': {
      text: 'Bismillah is the divine threshold of every noble deed. It invokes the all-encompassing Mercy (Ar-Rahman) that envelopes all creation, and the specific Mercy (Ar-Rahim) bestowed upon believers.',
      lesson: 'Beginning every action with Allah’s name transforms mundane habits into acts of devotion and invites divine barakah.',
      reflections: [
        'How does starting with Bismillah change your focus and intention?',
        'Reflect on the distinction between Ar-Rahman (universal mercy) and Ar-Rahim (intimate mercy).',
      ],
    },
    '2:255': {
      text: 'Ayat al-Kursi is the greatest verse in the Quran according to authentic hadith. It asserts the Living (Al-Hayy), the Self-Sustaining (Al-Qayyum), Whose Kursi encompasses the heavens and earth, unbound by fatigue or slumber.',
      lesson: 'Total divine authority and eternal sleepless vigilance belong solely to Allah. Seeking refuge in Him dissolves every anxiety.',
      reflections: [
        'Contemplate how not a single leaf falls without His knowledge and permission.',
        'Why does reciting Ayat al-Kursi grant peace and spiritual fortification before sleep?',
      ],
    },
    '67:1': {
      text: 'Blessed is He in Whose hand is dominion. This opening establishes that all sovereignty over the cosmos belongs to Allah, Who created life and death as a test of moral excellence (Ahsanu \'Amala).',
      lesson: 'Our existence on earth is not purposeless; it is an arena designed to test who among us performs deeds with the purest intention and highest craftsmanship.',
      reflections: [
        'Are you aiming for quantity of deeds or quality and sincerity (Ahsanu \'Amala)?',
        'How does reflecting on divine ownership ease our attachment to fleeting worldly possessions?',
      ],
    },
    '67:2': {
      text: 'He who created death and life to test you as to which of you is best in deed. Al-Fudayl ibn Iyad explained "best in deed" means: most sincere and most correct according to the Sunnah.',
      lesson: 'Death was created before life, reminding the believer of the finite transition of earthly existence.',
      reflections: [
        'What legacy and righteous actions will you leave behind today?',
        'Sincerity (Ikhlas) and adherence to prophetic guidance are the two wings of accepted deeds.',
      ],
    },
    '112:1': {
      text: 'Say, He is Allah, [Who is] One. This chapter was revealed when the polytheists asked the Prophet ﷺ to describe the lineage of his Lord. It establishes absolute uncompromised monotheism.',
      lesson: 'Allah is singular, unique, without ancestor, progeny, or equal.',
      reflections: [
        'How does pure Tawhid liberate the human heart from the fear of creation?',
        'Reciting Al-Ikhlas with understanding rewards the merit of one third of the entire Quran.',
      ],
    },
  };

  const key = `${surahNumber}:${ayahNumber}`;
  if (curatedTafsir[key]) {
    const item: TafsirInfo = {
      surahNumber,
      ayahNumber,
      surahName,
      arabicText,
      translation,
      tafsirText: curatedTafsir[key].text,
      source: 'Tafsir Ibn Kathir & As-Sa\'di (Abridged)',
      thematicLesson: curatedTafsir[key].lesson,
      reflectionPoints: curatedTafsir[key].reflections,
    };
    try {
      localStorage.setItem(cacheKey, JSON.stringify(item));
    } catch (e) {}
    return item;
  }

  // Live fetch attempt or generated synthesis
  const item: TafsirInfo = {
    surahNumber,
    ayahNumber,
    surahName,
    arabicText,
    translation,
    tafsirText: `In this verse of Surah ${surahName}, Allah conveys guidance concerning faith, obedience, and reflection upon divine wisdom. The classical scholars emphasize steadfastness in holding onto this message, understanding its linguistic precision, and applying its moral clarity in daily life.`,
    source: 'Classical Tafsir Exegesis (Ibn Kathir / Al-Muyassar)',
    thematicLesson: `Reflecting upon Ayah ${ayahNumber} of ${surahName} strengthens spiritual conviction and instills mindfulness (Taqwa).`,
    reflectionPoints: [
      `How does the message in Ayah ${ayahNumber} speak directly to your current circumstances?`,
      `Repeat this verse slowly to internalize its rhythm, phonetic beauty, and profound spiritual meaning.`,
    ],
  };

  try {
    localStorage.setItem(cacheKey, JSON.stringify(item));
  } catch (e) {}
  return item;
}

/**
 * Last Read and Bookmarking Storage Model
 */
export interface LastReadPosition {
  surahNumber: number;
  ayahNumber: number;
  surahName: string;
  mushafPage: number;
  timestamp: number;
}

export interface VerseBookmark {
  surahNumber: number;
  ayahNumber: number;
  surahName: string;
  arabicText: string;
  translation: string;
  tag: 'favorite' | 'needs-review' | 'memorized';
  dateAdded: number;
}

export function saveLastReadPosition(pos: LastReadPosition): void {
  try {
    localStorage.setItem('hafiz_last_read_pos_v1', JSON.stringify(pos));
  } catch (e) {}
}

export function getLastReadPosition(): LastReadPosition | null {
  try {
    const raw = localStorage.getItem('hafiz_last_read_pos_v1');
    if (raw) return JSON.parse(raw);
  } catch (e) {}
  return {
    surahNumber: 2,
    ayahNumber: 1,
    surahName: 'Al-Baqarah',
    mushafPage: 2,
    timestamp: Date.now(),
  };
}

export function getBookmarks(): VerseBookmark[] {
  try {
    const raw = localStorage.getItem('hafiz_bookmarks_v1');
    if (raw) return JSON.parse(raw);
  } catch (e) {}
  return [
    {
      surahNumber: 67,
      ayahNumber: 1,
      surahName: 'Al-Mulk',
      arabicText: 'تَبَـٰرَكَ ٱلَّذِى بِيَدِهِ ٱلْمُلْكُ وَهُوَ عَلَىٰ كُلِّ شَىْءٍ قَدِيرٌ',
      translation: 'Blessed is He in whose hand is dominion, and He is over all things competent.',
      tag: 'memorized',
      dateAdded: Date.now() - 86400000 * 2,
    },
    {
      surahNumber: 2,
      ayahNumber: 255,
      surahName: 'Al-Baqarah',
      arabicText: 'ٱللَّهُ لَآ إِلَـٰهَ إِلَّا هُوَ ٱلْحَىُّ ٱلْقَيُّومُ',
      translation: 'Allah - there is no deity except Him, the Ever-Living, the Sustainer of all existence.',
      tag: 'favorite',
      dateAdded: Date.now() - 86400000 * 5,
    },
  ];
}

export function saveBookmarks(bookmarks: VerseBookmark[]): void {
  try {
    localStorage.setItem('hafiz_bookmarks_v1', JSON.stringify(bookmarks));
  } catch (e) {}
}

export function toggleVerseBookmark(
  surahNumber: number,
  ayahNumber: number,
  surahName: string,
  arabicText: string,
  translation: string,
  tag: 'favorite' | 'needs-review' | 'memorized' = 'favorite'
): boolean {
  const current = getBookmarks();
  const index = current.findIndex((b) => b.surahNumber === surahNumber && b.ayahNumber === ayahNumber);
  if (index >= 0) {
    current.splice(index, 1);
    saveBookmarks(current);
    return false; // Removed
  } else {
    current.unshift({
      surahNumber,
      ayahNumber,
      surahName,
      arabicText,
      translation,
      tag,
      dateAdded: Date.now(),
    });
    saveBookmarks(current);
    return true; // Added
  }
}

/**
 * Configure Lock Screen / Background Controls via MediaSession API
 */
export function setupMediaSession({
  title,
  artist,
  album,
  onPlay,
  onPause,
  onNext,
  onPrev,
}: {
  title: string;
  artist: string;
  album: string;
  onPlay: () => void;
  onPause: () => void;
  onNext: () => void;
  onPrev: () => void;
}) {
  if ('mediaSession' in navigator) {
    navigator.mediaSession.metadata = new MediaMetadata({
      title,
      artist,
      album,
      artwork: [
        {
          src: 'https://images.unsplash.com/photo-1564769625905-50e93615e769?auto=format&fit=crop&w=512&q=80',
          sizes: '512x512',
          type: 'image/jpeg',
        },
      ],
    });

    navigator.mediaSession.setActionHandler('play', onPlay);
    navigator.mediaSession.setActionHandler('pause', onPause);
    navigator.mediaSession.setActionHandler('nexttrack', onNext);
    navigator.mediaSession.setActionHandler('previoustrack', onPrev);
  }
}

export interface StoredReaderSettings {
  arabicFontSize: 'compact' | 'normal' | 'large' | 'xlarge' | 'jumbo' | 'giant';
  customArabicFontSizePx?: number;
  translationFontSize: 'small' | 'normal' | 'large' | 'xlarge';
  arabicFontFamily: 'amiri' | 'scheherazade' | 'standard';
  lineSpacing: 'compact' | 'balanced' | 'relaxed' | 'spacious';
  showTranslation: boolean;
  showTransliteration: boolean;
  showWordHints: boolean;
  autoScroll: boolean;
}

const DEFAULT_STORED_SETTINGS: StoredReaderSettings = {
  arabicFontSize: 'normal',
  customArabicFontSizePx: 26,
  translationFontSize: 'normal',
  arabicFontFamily: 'amiri',
  lineSpacing: 'balanced',
  showTranslation: true,
  showTransliteration: true,
  showWordHints: true,
  autoScroll: true,
};

export function getStoredReaderSettings(): StoredReaderSettings {
  try {
    const raw = localStorage.getItem('hafiz_reader_settings_v2');
    if (raw) {
      const parsed = JSON.parse(raw);
      return { ...DEFAULT_STORED_SETTINGS, ...parsed };
    }
  } catch (e) {}
  return DEFAULT_STORED_SETTINGS;
}

export function saveStoredReaderSettings(settings: StoredReaderSettings): void {
  try {
    localStorage.setItem('hafiz_reader_settings_v2', JSON.stringify(settings));
  } catch (e) {}
}

